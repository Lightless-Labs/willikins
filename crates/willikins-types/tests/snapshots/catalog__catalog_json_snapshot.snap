[
  {
    "name": "WordList",
    "secret": false,
    "identifier": false,
    "description": "An ordered, non-empty list of lowercase ASCII words, serialised as kebab-case.",
    "example": "third-thoughts",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WordList",
      "description": "An ordered, non-empty list of lowercase ASCII words, serialised as kebab-case.",
      "type": "string",
