      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleKeyId",
      "description": "An App Store Connect API key's key id (goes in the JWT `kid` header).",
      "type": "string",
      "examples": [
        "2X9R4HXF34"
      ],
      "pattern": "^(?:[A-Z0-9]{2,32})$"
    }
  },
  {
    "name": "AppleBundleIdentifier",
    "secret": false,
    "identifier": false,
    "description": "An App Store Connect bundle identifier string, such as `com.example.MyApp`. Immutable once created.",
    "example": "com.example.MyApp",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleBundleIdentifier",
      "description": "An App Store Connect bundle identifier string, such as `com.example.MyApp`. Immutable once created.",
      "type": "string",
      "examples": [
        "com.example.MyApp"
      ],
      "maxLength": 255,
      "pattern": "^(?:[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)$"
    }
  },
  {
    "name": "AppleBundleIdName",
    "secret": false,
    "identifier": false,
    "description": "A bundle id's human-written `name` attribute.",
    "example": "third-thoughts",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleBundleIdName",
      "description": "A bundle id's human-written `name` attribute.",
      "type": "string",
      "examples": [
        "third-thoughts"
      ],
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9 -]+)$"
    }
  },
  {
    "name": "AppleBundleIdPlatform",
    "secret": false,
    "identifier": false,
    "description": "An App Store Connect bundle id's platform: IOS, MAC_OS, or UNIVERSAL. Immutable once created.",
    "example": "UNIVERSAL",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleBundleIdPlatform",
      "description": "An App Store Connect bundle id's platform: IOS, MAC_OS, or UNIVERSAL. Immutable once created.",
      "type": "string",
      "examples": [
        "UNIVERSAL"
      ],
      "pattern": "^(?:IOS|MAC_OS|UNIVERSAL)$"
    }
  },
  {
    "name": "AppleBundleIdId",
    "secret": false,
    "identifier": true,
    "description": "An App Store Connect bundle id's Apple-assigned opaque record id.",
    "example": "T6G4XCV345",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleBundleIdId",
      "description": "An App Store Connect bundle id's Apple-assigned opaque record id.",
      "type": "string",
      "examples": [
        "T6G4XCV345"
      ],
      "pattern": "^(?:[A-Za-z0-9]{2,64})$"
    }
  },
  {
    "name": "AppleCapabilityType",
    "secret": false,
    "identifier": false,
    "description": "An App Store Connect bundle id capability type.",
    "example": "PUSH_NOTIFICATIONS",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleCapabilityType",
      "description": "An App Store Connect bundle id capability type.",
      "type": "string",
      "examples": [
        "PUSH_NOTIFICATIONS"
      ],
      "pattern": "^(?:ICLOUD|IN_APP_PURCHASE|GAME_CENTER|PUSH_NOTIFICATIONS|WALLET|INTER_APP_AUDIO|MAPS|ASSOCIATED_DOMAINS|PERSONAL_VPN|APP_GROUPS|HEALTHKIT|HOMEKIT|WIRELESS_ACCESSORY_CONFIGURATION|APPLE_PAY|DATA_PROTECTION|SIRIKIT|NETWORK_EXTENSIONS|MULTIPATH|HOT_SPOT|NFC_TAG_READING|CLASSKIT|AUTOFILL_CREDENTIAL_PROVIDER|ACCESS_WIFI_INFORMATION|NETWORK_CUSTOM_PROTOCOL|COREMEDIA_HLS_LOW_LATENCY|SYSTEM_EXTENSION_INSTALL|USER_MANAGEMENT|APPLE_ID_AUTH)$"
    }
  },
  {
    "name": "AppleObservableCapabilityType",
    "secret": false,
    "identifier": false,
    "description": "Every bundle id capability type this crate can observe on a read, including two (APP_ATTEST, APP_ATTEST_OPT_IN) the API reports but refuses to create -- a read-only superset of AppleCapabilityType.",
    "example": "APP_ATTEST",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleObservableCapabilityType",
      "description": "Every bundle id capability type this crate can observe on a read, including two (APP_ATTEST, APP_ATTEST_OPT_IN) the API reports but refuses to create -- a read-only superset of AppleCapabilityType.",
      "type": "string",
      "examples": [
        "APP_ATTEST"
      ],
      "pattern": "^(?:ICLOUD|IN_APP_PURCHASE|GAME_CENTER|PUSH_NOTIFICATIONS|WALLET|INTER_APP_AUDIO|MAPS|ASSOCIATED_DOMAINS|PERSONAL_VPN|APP_GROUPS|HEALTHKIT|HOMEKIT|WIRELESS_ACCESSORY_CONFIGURATION|APPLE_PAY|DATA_PROTECTION|SIRIKIT|NETWORK_EXTENSIONS|MULTIPATH|HOT_SPOT|NFC_TAG_READING|CLASSKIT|AUTOFILL_CREDENTIAL_PROVIDER|ACCESS_WIFI_INFORMATION|NETWORK_CUSTOM_PROTOCOL|COREMEDIA_HLS_LOW_LATENCY|SYSTEM_EXTENSION_INSTALL|USER_MANAGEMENT|APPLE_ID_AUTH|APP_ATTEST|APP_ATTEST_OPT_IN)$"
    }
  },
  {
    "name": "AppleCapabilitySetting",
    "secret": false,
    "identifier": false,
    "description": "An App Store Connect bundle id capability setting, KEY=OPTION (a data protection class or a Sign in with Apple consent scope).",
    "example": "DATA_PROTECTION_PERMISSION_LEVEL=PROTECTED_UNTIL_FIRST_USER_AUTH",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleCapabilitySetting",
      "description": "An App Store Connect bundle id capability setting, KEY=OPTION (a data protection class or a Sign in with Apple consent scope).",
      "type": "string",
      "examples": [
        "DATA_PROTECTION_PERMISSION_LEVEL=PROTECTED_UNTIL_FIRST_USER_AUTH"
      ],
      "pattern": "^(?:DATA_PROTECTION_PERMISSION_LEVEL=COMPLETE_PROTECTION|DATA_PROTECTION_PERMISSION_LEVEL=PROTECTED_UNLESS_OPEN|DATA_PROTECTION_PERMISSION_LEVEL=PROTECTED_UNTIL_FIRST_USER_AUTH|APPLE_ID_AUTH_APP_CONSENT=PRIMARY_APP_CONSENT)$"
    }
  },
  {
    "name": "AppleCertificateType",
    "secret": false,
    "identifier": false,
    "description": "An App Store Connect certificate type: DISTRIBUTION or IOS_DISTRIBUTION (the two that can sign an App Store distribution profile).",
    "example": "DISTRIBUTION",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleCertificateType",
      "description": "An App Store Connect certificate type: DISTRIBUTION or IOS_DISTRIBUTION (the two that can sign an App Store distribution profile).",
      "type": "string",
      "examples": [
        "DISTRIBUTION"
      ],
      "pattern": "^(?:DISTRIBUTION|IOS_DISTRIBUTION)$"
    }
  },
  {
    "name": "AppleCertificateSerial",
    "secret": false,
    "identifier": true,
    "description": "An App Store Connect certificate's serial number (uppercase hexadecimal).",
    "example": "7B3F2A9C1D4E5F607182930A1B2C3D4E5F60",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleCertificateSerial",
      "description": "An App Store Connect certificate's serial number (uppercase hexadecimal).",
      "type": "string",
      "examples": [
        "7B3F2A9C1D4E5F607182930A1B2C3D4E5F60"
      ],
      "pattern": "^(?:[0-9A-F]{1,64})$"
    }
  },
  {
    "name": "AppleCertificateId",
    "secret": false,
    "identifier": true,
    "description": "An App Store Connect certificate's Apple-assigned opaque record id.",
    "example": "C3RT1F1CATE9",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleCertificateId",
      "description": "An App Store Connect certificate's Apple-assigned opaque record id.",
      "type": "string",
      "examples": [
        "C3RT1F1CATE9"
      ],
      "pattern": "^(?:[A-Za-z0-9]{2,64})$"
    }
  },
  {
    "name": "AppleProfileType",
    "secret": false,
    "identifier": false,
    "description": "An App Store Connect provisioning profile type: IOS_APP_STORE only (every other profile type is out of scope and refused by this grammar).",
    "example": "IOS_APP_STORE",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleProfileType",
      "description": "An App Store Connect provisioning profile type: IOS_APP_STORE only (every other profile type is out of scope and refused by this grammar).",
      "type": "string",
      "examples": [
        "IOS_APP_STORE"
      ],
      "pattern": "^(?:IOS_APP_STORE)$"
    }
  },
  {
    "name": "AppleProfileName",
    "secret": false,
    "identifier": false,
    "description": "A provisioning profile's human-written `name` attribute.",
    "example": "willikins-probe-delete-me-example",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleProfileName",
      "description": "A provisioning profile's human-written `name` attribute.",
      "type": "string",
      "examples": [
        "willikins-probe-delete-me-example"
      ],
      "maxLength": 255,
      "minLength": 1
    }
  },
  {
    "name": "AppleProfileId",
    "secret": false,
    "identifier": true,
    "description": "An App Store Connect provisioning profile's Apple-assigned opaque record id.",
    "example": "PR0F1LE1D9999",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleProfileId",
      "description": "An App Store Connect provisioning profile's Apple-assigned opaque record id.",
      "type": "string",
      "examples": [
        "PR0F1LE1D9999"
      ],
      "pattern": "^(?:[A-Za-z0-9]{2,64})$"
    }
  },
  {
    "name": "AppleProfileContent",
    "secret": true,
    "identifier": false,
    "description": "An App Store Connect provisioning profile's base64-encoded content (a CMS-signed property list). Secret.",
    "example": "[ELIDED SECRET EXAMPLE]",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppleProfileContent",
      "description": "An App Store Connect provisioning profile's base64-encoded content (a CMS-signed property list). Secret.",
      "type": "string",
      "examples": [
        "[ELIDED SECRET EXAMPLE]"
      ],
      "maxLength": 65536,
      "pattern": "^(?:[A-Za-z0-9+/]+={0,2})$"
    }
  },
  {
    "name": "OperatorAcknowledgement",
    "secret": false,
    "identifier": false,
    "description": "An operator's acknowledgement that a manual step is done (the only valid value is `done`); never defaulted, never a literal.",
    "example": "done",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "OperatorAcknowledgement",
      "description": "An operator's acknowledgement that a manual step is done (the only valid value is `done`); never defaulted, never a literal.",
      "type": "string",
      "examples": [
        "done"
      ],
      "pattern": "^(?:done)$"
    }
  }
]
