---
source: crates/willikins-providers-fake/src/lib.rs
expression: "catalog.list_tools_json()[\"tools\"]"
---
[
  {
    "class": "reversible",
    "description": "Derive this project's GitHub repository, Doppler project, and Buildkite pipeline slug identities from its org and slug.",
    "inputs": {
      "org": {
        "required": true,
        "ty": {
          "kind": "exact",
          "type": "GitHubOrg"
        }
      },
      "slug": {
        "required": true,
        "ty": {
          "kind": "exact",
          "type": "ProjectSlug"
        }
      }
    },
    "key": [],
    "name": "naming.v1",
    "outputs": {
      "buildkite_pipeline_slug": "BuildkitePipelineSlug",
      "doppler_project": "DopplerProject",
      "github_repo": "GitHubRepo"
    },
    "pure": true
  },
  {
    "class": "reversible",
    "description": "Ensure a GitHub repository exists.",
    "inputs": {
      "repo": {
        "required": true,
        "ty": {
          "kind": "exact",
          "type": "GitHubRepo"
        }
      },
      "visibility": {
        "required": true,
        "ty": {
          "kind": "exact",
          "type": "RepoVisibility"
        }
      }
    },
    "key": [
      "repo"
    ],
    "name": "github.repo.ensure",
    "outputs": {
      "repo": "GitHubRepo",
      "url": "HttpsUrl"
    },
    "pure": false
  },
  {
    "class": "reversible",
    "description": "Ensure a GitHub Actions repository secret exists. Never reads or stores its value.",
    "inputs": {
      "name": {
        "required": true,
        "ty": {
          "kind": "exact",
          "type": "ActionsSecretName"
        }
      },
      "repo": {
        "required": true,
        "ty": {
          "kind": "exact",
          "type": "GitHubRepo"
        }
      },
      "value": {
        "required": true,
        "ty": {
          "kind": "any_secret"
        }
      }
    },
    "key": [
      "repo",
      "name"
    ],
    "name": "github.actions_secret.ensure",
    "outputs": {},
    "pure": false
  },
  {
    "class": "reversible",
    "description": "Ensure a Doppler project exists.",
