---
source: crates/willikins-tools/src/lib.rs
expression: specs
---
[
  {
    "name": "naming.v1",
    "description": "Derive this project's GitHub repository, Doppler project, and Buildkite pipeline slug identities from its org and slug.",
    "inputs": {
      "org": {
        "ty": {
          "kind": "exact",
          "type": "GitHubOrg"
        },
        "required": true
      },
      "slug": {
        "ty": {
          "kind": "exact",
          "type": "ProjectSlug"
        },
        "required": true
      }
    },
    "outputs": {
      "github_repo": "GitHubRepo",
      "doppler_project": "DopplerProject",
      "buildkite_pipeline_slug": "BuildkitePipelineSlug"
    },
    "key": [],
    "class": "reversible",
    "pure": true
  },
  {
    "name": "template.render",
    "description": "Render a template, replacing every `{{ value }}` with a plain-text value.",
    "inputs": {
      "template": {
        "ty": {
          "kind": "exact",
          "type": "TemplateSource"
        },
        "required": true
      },
      "value": {
        "ty": {
          "kind": "exact",
          "type": "Text"
        },
        "required": true
      }
    },
    "outputs": {
      "rendered": "Text"
    },
    "key": [],
    "class": "reversible",
    "pure": true
  },
  {
    "name": "env.get",
    "description": "Read a WILLIKINS_-namespaced environment variable's value.",
    "inputs": {
      "name": {
        "ty": {
          "kind": "exact",
          "type": "EnvVarName"
        },
        "required": true
      }
    },
    "outputs": {
      "value": "OpaqueSecret"
    },
    "key": [],
    "class": "reversible",
    "pure": true
  },
  {
    "name": "base64.decode",
    "description": "Base64-decode a secret value (RFC 4648 standard alphabet, padding either way, ASCII whitespace stripped first); the decoded bytes must be UTF-8.",
    "inputs": {
      "value": {
        "ty": {
          "kind": "any_secret"
        },
        "required": true
      }
    },
    "outputs": {
      "value": "OpaqueSecret"
    },
    "key": [],
    "class": "reversible",
    "pure": true
  },
  {
    "name": "apple.signing_key.parse",
    "description": "Parse a decoded secret as an EC P-256 (PKCS#8 or SEC1 PEM) App Store Connect signing key.",
    "inputs": {
      "value": {
        "ty": {
          "kind": "any_secret"
        },
        "required": true
      }
    },
    "outputs": {
      "value": "AppleSigningKey"
    },
    "key": [],
    "class": "reversible",
    "pure": true
  }
]
