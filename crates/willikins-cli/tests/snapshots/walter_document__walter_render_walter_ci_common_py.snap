"""Walter CI: guest identity, private clone, artifacts, strict JSON, Doppler fetch.

Every subprocess runs as one argv list behind an injectable runner; the shell
is never invoked. Every network call goes through an injectable opener. No
Doppler value is ever printed, logged or written to a file.
"""
import hashlib
import json
import os
import re
import ssl
import stat
import subprocess
import urllib.parse
import urllib.request

GUEST_PATH = "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
DEVELOPER_DIR = "/Applications/Xcode_26.3.app/Contents/Developer"
IDENTITY_NAMES = (
    "BUILDKITE_COMMIT", "BUILDKITE_JOB_ID", "BUILDKITE_BUILD_ID",
    "BUILDKITE_BUILD_NUMBER", "BUILDKITE_PIPELINE_SLUG", "BUILDKITE_BUILD_URL", "CI",
)

DOPPLER_PROJECT = "walter"
DOPPLER_CONFIG = "prd_deployment_ios"
DOPPLER_URL = "https://api.doppler.com/v3/configs/config/secrets/download?" + urllib.parse.urlencode(
    {"project": DOPPLER_PROJECT, "config": DOPPLER_CONFIG, "format": "json"}
)
ASC_SECRET_NAMES = (
    "APP_STORE_CONNECT_API_KEY_ISSUER_ID", "APP_STORE_CONNECT_API_KEY_ID", "APP_STORE_CONNECT_API_KEY_BASE64",
)
SIGNING_SECRET_NAMES = ASC_SECRET_NAMES + (
    "APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64", "APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD",
)
DOPPLER_STAGE_NAMES = {"signing": SIGNING_SECRET_NAMES, "package": SIGNING_SECRET_NAMES, "upload": ASC_SECRET_NAMES}

ARTIFACT_ROOT = ("apps", "walter", ".ci-artifacts")
ARTIFACT_STAGES = ("validation", "signing-preflight", "package", "upload-input", "upload")

MAX_JSON_BYTES = 65536
MAX_RESPONSE_BYTES = 1024 * 1024
MAX_TOKEN_LENGTH = 8192
TIMEOUT_SECONDS = 30


class WalterCiError(RuntimeError):
    """A bounded, input-free failure: only a fixed, non-secret message crosses this boundary."""


def child_env():
    """A fresh guest env: only PATH, DEVELOPER_DIR, LANG, LC_ALL, HOME, TMPDIR, CI -- never DOPPLER_TOKEN."""
    env = {"PATH": GUEST_PATH, "DEVELOPER_DIR": DEVELOPER_DIR, "LANG": "en_US.UTF-8", "LC_ALL": "en_US.UTF-8"}
    for name in ("HOME", "TMPDIR", "CI"):
        value = os.environ.get(name)
        if value is not None:
            env[name] = value
    return env


def default_runner(argv, *, cwd=None, env=None, timeout=None, input=None):
    """The production runner: one argv list, never a shell, never the ambient env."""
    completed = subprocess.run(
        list(argv), cwd=cwd, env=env if env is not None else child_env(), timeout=timeout, input=input,
        stdin=subprocess.DEVNULL if input is None else None,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    return {"returncode": completed.returncode, "stdout": completed.stdout, "stderr": completed.stderr}


def _run_checked(runner, argv, error, **kwargs):
    try:
        result = runner(argv, **kwargs)
    except Exception:
        raise WalterCiError(error) from None
    if type(result) is not dict or result.get("returncode") != 0:
        raise WalterCiError(error)
    return result.get("stdout") or b""


def verify_source(mount, *, runner=default_runner):
    """Verify the mount is the pinned commit, clean, then clone it privately and verify again."""
    env = child_env()
    commit = os.environ.get("BUILDKITE_COMMIT") or ""
    if re.fullmatch(r"[0-9a-f]{40}", commit) is None:
        raise WalterCiError("BUILDKITE_COMMIT must be exactly 40 hex characters")
    job_id = os.environ.get("BUILDKITE_JOB_ID") or ""
    if re.fullmatch(r"[0-9a-f-]{1,128}", job_id) is None:
        raise WalterCiError("BUILDKITE_JOB_ID has an unexpected shape")

    def verify(path):
        head = _run_checked(runner, ["git", "-C", path, "rev-parse", "HEAD"], "reading HEAD failed", env=env, timeout=30)
        if head.decode("utf-8", "strict").strip() != commit:
            raise WalterCiError("HEAD does not match the pinned commit")
        status = _run_checked(runner, ["git", "-C", path, "status", "--porcelain"], "git status failed", env=env, timeout=60)
        if status.strip():
            raise WalterCiError("the checkout is not clean")

    verify(mount)
    tmpdir = os.environ.get("TMPDIR") or "/tmp"
    clone = os.path.join(tmpdir, "walter-src-" + job_id)
    if os.path.lexists(clone):
        raise WalterCiError("the private clone path already exists")
    _run_checked(runner, ["git", "clone", "--no-hardlinks", "--", mount, clone], "the private clone failed", env=env, timeout=600)
    _run_checked(
        runner, ["git", "-C", clone, "checkout", "--detach", commit], "checking out the pinned commit failed", env=env, timeout=120
    )
    verify(clone)
    return clone


def artifact_dir(mount, stage):
    """`apps/walter/.ci-artifacts/<stage>/` under `mount`, refusing any symlinked parent."""
    if type(mount) is not str or type(stage) is not str or stage not in ARTIFACT_STAGES:
        raise WalterCiError("unknown artifact stage")
    path = mount
    for part in ARTIFACT_ROOT + (stage,):
        path = os.path.join(path, part)
        if os.path.islink(path):
            raise WalterCiError("the artifact path has a symlinked component")
    os.makedirs(path, exist_ok=True)
    return path


def sha256_file(path):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise WalterCiError("could not open the expected file") from None
    digest = hashlib.sha256()
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise WalterCiError("refusing a non-regular file")
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def write_json_exclusive(path, obj):
    """Write `obj` as compact, sorted JSON to a file that must not already exist."""
    raw = json.dumps(obj, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("utf-8") + b"\n"
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    except OSError:
        raise WalterCiError("the receipt already exists or its directory is missing") from None
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise WalterCiError("duplicate JSON key")
        result[key] = value
    return result


def _reject_constant(_value):
    raise WalterCiError("JSON used a non-finite constant")


def parse_strict_json(raw):
    try:
        return json.loads(raw.decode("utf-8"), object_pairs_hook=_unique_object, parse_constant=_reject_constant)
    except WalterCiError:
        raise
    except Exception:
        raise WalterCiError("invalid JSON") from None


def _read_file(path, limit):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise WalterCiError("could not open the expected file") from None
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise WalterCiError("refusing a non-regular file")
        data = handle.read(limit + 1)
    if len(data) > limit:
        raise WalterCiError("file exceeds the size limit")
    return data


def read_json_strict(path, *, max_bytes=MAX_JSON_BYTES):
    return parse_strict_json(_read_file(path, max_bytes))


_BUNDLE_ID_CHARS = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-")


def _is_bundle_id(value):
    return type(value) is str and len(value) > 0 and all(c in _BUNDLE_ID_CHARS for c in value)


def _is_semver(value):
    if type(value) is not str:
        return False
    parts = value.split(".")
    return len(parts) == 3 and all(part.isdigit() for part in parts)


def load_release_config(repo):
    """Strict-JSON load of `apps/walter/tools/release-config.json`, validated against decision (h)'s schema."""
    path = os.path.join(repo, "apps", "walter", "tools", "release-config.json")
    parsed = read_json_strict(path)
    if type(parsed) is not dict or set(parsed) != {
        "schema", "bundle_ids", "marketing_version", "build_number_offset", "doppler", "bazel_target",
    }:
        raise WalterCiError("release-config.json has an unexpected shape")
    if parsed.get("schema") != 1:
        raise WalterCiError("release-config.json has an unsupported schema")
    bundle_ids = parsed["bundle_ids"]
    if type(bundle_ids) is not dict or set(bundle_ids) != {"app", "nse", "widgets"}:
        raise WalterCiError("release-config.json's bundle_ids has an unexpected shape")
    for key, value in bundle_ids.items():
        if not _is_bundle_id(value):
            raise WalterCiError("release-config.json's bundle_ids." + key + " is invalid")
    if not _is_semver(parsed["marketing_version"]):
        raise WalterCiError("release-config.json's marketing_version is not semver")
    offset = parsed["build_number_offset"]
    if type(offset) is not int or type(offset) is bool or offset < 0:
        raise WalterCiError("release-config.json's build_number_offset must be a non-negative integer")
    doppler = parsed["doppler"]
    if (
        type(doppler) is not dict
        or set(doppler) != {"project", "config"}
        or doppler.get("project") != DOPPLER_PROJECT
        or doppler.get("config") != DOPPLER_CONFIG
    ):
        raise WalterCiError("release-config.json's doppler block does not match the pinned project/config")
    bazel_target = parsed["bazel_target"]
    if type(bazel_target) is not str or not bazel_target.startswith("//"):
        raise WalterCiError("release-config.json's bazel_target is invalid")
    return parsed


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, msg, headers, newurl):
        raise WalterCiError("the response attempted a redirect") from None


def build_opener():
    """A fresh, proxy-free, non-redirecting opener with verified TLS."""
    return urllib.request.build_opener(
        urllib.request.ProxyHandler({}), _NoRedirect(), urllib.request.HTTPSHandler(context=ssl.create_default_context())
    )


def read_bounded(opener, request, expected_url, *, max_bytes=MAX_RESPONSE_BYTES, timeout=TIMEOUT_SECONDS):
    """Open `request`, requiring status 200, the expected final URL, and a bounded body."""
    response = None
    try:
        response = opener.open(request, timeout=timeout)
        status = response.getcode()
        if type(status) is not int or status != 200 or response.geturl() != expected_url:
            raise WalterCiError("the server responded unexpectedly")
        body = response.read(max_bytes + 1)
        if type(body) is not bytes or len(body) > max_bytes:
            raise WalterCiError("the response exceeded the size limit")
        return body
    finally:
        if response is not None:
            response.close()


def fetch_doppler(stage, *, opener=None):
    """Fetch Walter's deployment config and return only `stage`'s allowlisted names."""
    token = os.environ.pop("DOPPLER_TOKEN", None)
    if stage not in DOPPLER_STAGE_NAMES:
        raise WalterCiError("unknown Doppler stage")
    if type(token) is not str or not 1 <= len(token) <= MAX_TOKEN_LENGTH:
        raise WalterCiError("DOPPLER_TOKEN is missing or malformed")
    try:
        request = urllib.request.Request(
            DOPPLER_URL, headers={"Authorization": "Bearer " + token, "Accept": "application/json"}, method="GET"
        )
        body = read_bounded(opener or build_opener(), request, DOPPLER_URL)
        parsed = parse_strict_json(body)
    except WalterCiError:
        raise
    except Exception:
        raise WalterCiError("fetching Doppler secrets failed") from None
    if type(parsed) is not dict or any(type(k) is not str or type(v) is not str for k, v in parsed.items()):
        raise WalterCiError("the Doppler response has an unexpected shape")
    names = DOPPLER_STAGE_NAMES[stage]
    missing = sorted(name for name in names if name not in parsed)
    if missing:
        raise WalterCiError("Doppler config is missing: " + ", ".join(missing))
    return {name: parsed[name] for name in names}
