apps/walter/tools/walter_ci.py
---
"""Walter CI: the entry point. One argparse subcommand per release stage --
`validate`, `signing-preflight`, `package`, `stage-ipa` (host) and `upload` --
chained by `.buildkite/release.yml`. Every subprocess runs through an
injectable runner; stage-ipa touches neither Doppler nor Apple. Each stage
writes an exclusive receipt before it can be blindly re-run.
"""
import argparse
import base64
import os
import re
import shutil
import stat
import sys
import tempfile
import time

from walter_asc import AscClient, make_jwt
from walter_ci_common import (
    WalterCiError,
    artifact_dir,
    child_env,
    default_runner,
    fetch_doppler,
    load_release_config,
    read_json_strict,
    sha256_file,
    verify_source,
    write_json_exclusive,
)
from walter_ipa import inspect
from walter_signing import (
    SigningKeychain,
    assert_clean,
    check_signing,
    identities,
    install_profile,
    keychain_path,
    profile_facts,
)

SCHEMA = 1
DEVICE_SDKS = ("iphoneos", "iphonesimulator")
HOST_MACOS_FLAGS = ("--host_macos_minimum_os=15.0", "--macos_minimum_os=15.0")

_COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
_ID_RE = re.compile(r"^[0-9A-Za-z-]{1,128}$")
_BUILD_NUMBER_RE = re.compile(r"^[0-9]{1,10}$")
_KEY_ID_RE = re.compile(r"^[A-Za-z0-9]{1,32}$")

ENTITLEMENTS_FILES = {
    "app": ("ios", "Resources", "Walter.entitlements"),
    "nse": ("ios", "Resources", "WalterNotificationService.entitlements"),
    "widgets": ("ios", "Resources", "WalterWidgets.entitlements"),
}


def identity():
    """The Buildkite identifiers every receipt and host check needs, validated."""
    commit = os.environ.get("BUILDKITE_COMMIT") or ""
    if _COMMIT_RE.match(commit) is None:
        raise WalterCiError("BUILDKITE_COMMIT must be exactly 40 hex characters")
    build_id = os.environ.get("BUILDKITE_BUILD_ID") or ""
    job_id = os.environ.get("BUILDKITE_JOB_ID") or ""
    if _ID_RE.match(build_id) is None or _ID_RE.match(job_id) is None:
        raise WalterCiError("a Buildkite identifier has an unexpected shape")
    raw_number = os.environ.get("BUILDKITE_BUILD_NUMBER") or ""
    if _BUILD_NUMBER_RE.match(raw_number) is None:
        raise WalterCiError("BUILDKITE_BUILD_NUMBER must be a positive integer")
    return {"commit": commit, "build_id": build_id, "job_id": job_id, "build_number": int(raw_number)}


def build_version(ident, config):
    """`BUILDKITE_BUILD_NUMBER + offset`; `CFBundleVersion` is `<marketing>.<build>`."""
    number = ident["build_number"] + config["build_number_offset"]
    return number, config["marketing_version"] + "." + str(number)


def _run(runner, argv, *, cwd=None, env=None, timeout, error):
    try:
        result = runner(argv, cwd=cwd, env=env, timeout=timeout)
    except Exception:
        raise WalterCiError(error) from None
    if type(result) is not dict or result.get("returncode") != 0:
        raise WalterCiError(error)
    return result.get("stdout") or b""


def _write_receipt(mount, stage, ident, ok, checks, *, name=None):
    receipt = {
        "schema": SCHEMA, "stage": stage, "commit": ident["commit"], "build_id": ident["build_id"],
        "job_id": ident["job_id"], "build_number": ident["build_number"], "ok": ok, "checks": checks,
    }
    write_json_exclusive(os.path.join(artifact_dir(mount, stage), name or (stage + "-receipt.json")), receipt)
    return receipt


def _require_regular_file(path):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise WalterCiError("an expected artifact is missing or not a regular file") from None
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise WalterCiError("an expected artifact is not a regular file")


def _verify_receipt(receipt_path, artifact_path, *, commit):
    """Check a package receipt's commit, size and SHA-256 against the artifact beside it."""
    receipt = read_json_strict(receipt_path)
    if receipt.get("commit") != commit:
        raise WalterCiError("the receipt's commit does not match this build")
    checks = receipt.get("checks") if type(receipt.get("checks")) is dict else {}
    size = os.stat(artifact_path).st_size
    if checks.get("size") != size:
        raise WalterCiError("the receipt's size does not match the artifact")
    digest = sha256_file(artifact_path)
    if checks.get("sha256") != digest:
        raise WalterCiError("the receipt's hash does not match the artifact")
    return digest


def _move_into(src, dest):
    if os.path.lexists(dest):
        raise WalterCiError("the destination already has a file")
    shutil.move(src, dest)


def _preflight(runner):
    env = child_env()
    _run(runner, ["xcodebuild", "-version"], env=env, timeout=60, error="xcodebuild -version failed")
    for sdk in DEVICE_SDKS:
        _run(runner, ["xcrun", "--sdk", sdk, "--show-sdk-path"], env=env, timeout=30, error="the " + sdk + " SDK path is unavailable")


def _check_bazel_version(runner, repo):
    try:
        with open(os.path.join(repo, ".bazelversion"), "r", encoding="utf-8") as handle:
            pinned = handle.read().strip()
    except OSError:
        raise WalterCiError(".bazelversion is missing") from None
    if not pinned:
        raise WalterCiError(".bazelversion is empty")
    output = _run(runner, ["bazel", "--version"], env=child_env(), timeout=60, error="bazel --version failed")
    if pinned not in output.decode("utf-8", "replace"):
        raise WalterCiError("bazel --version does not match .bazelversion")


class _ApiKey:
    """Writes the App Store Connect `.p8` as `AuthKey_<id>.p8` in a fresh 0700 directory."""

    def __init__(self, secrets):
        key_id = secrets["APP_STORE_CONNECT_API_KEY_ID"]
        if _KEY_ID_RE.match(key_id) is None:
            raise WalterCiError("the App Store Connect key id has an unexpected shape")
        self._b64 = secrets["APP_STORE_CONNECT_API_KEY_BASE64"]
        self.issuer = secrets["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
        self.key_id = key_id
        self.directory = None
        self.path = None

    def __enter__(self):
        self.directory = tempfile.mkdtemp(prefix="walter-asc-key-")
        try:
            os.chmod(self.directory, 0o700)
            self.path = os.path.join(self.directory, "AuthKey_" + self.key_id + ".p8")
            try:
                data = base64.b64decode(self._b64, validate=True)
            except Exception:
                raise WalterCiError("the App Store Connect key is not valid base64") from None
            descriptor = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(data)
        except BaseException:
            self.__exit__(None, None, None)
            raise
        return self

    def __exit__(self, *_exc):
        if self.directory is not None:
            shutil.rmtree(self.directory, ignore_errors=True)
            self.directory = None
        return False


def _asc_client(api_key, runner):
    token = make_jwt(api_key.issuer, api_key.key_id, api_key.path, time.time(), runner=runner)
    return AscClient(token)


def _altool_env(api_key):
    env = child_env()
    env["API_PRIVATE_KEYS_DIR"] = api_key.directory
    return env


def _load_entitlements(repo, bundle_ids):
    import plistlib
    result = {}
    for key, relative in ENTITLEMENTS_FILES.items():
        path = os.path.join(repo, "apps", "walter", *relative)
        try:
            with open(path, "rb") as handle:
                result[bundle_ids[key]] = plistlib.load(handle)
        except Exception:
            raise WalterCiError("reading " + relative[-1] + " failed") from None
    return result


def _signing_checks(runner, secrets, config, repo, *, inner=None):
    """Cookbook section 6.3: fetch, install, intersect, and cover every entitlement.
    `inner`, if given, runs inside the keychain after the checks pass."""
    bundle_ids = config["bundle_ids"]
    with _ApiKey(secrets) as api_key:
        client = _asc_client(api_key, runner)
        profiles_raw = {bundle_id: client.profile_content(bundle_id) for bundle_id in bundle_ids.values()}
    entitlements = _load_entitlements(repo, bundle_ids)
    p12 = base64.b64decode(secrets["APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64"], validate=True)
    password = secrets["APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD"]
    keychain = SigningKeychain(p12, password, runner=runner)
    with keychain:
        profiles = {}
        for bundle_id, raw in profiles_raw.items():
            install_profile(raw, runner=runner)
            profiles[bundle_id] = profile_facts(raw, runner=runner)
        identity_set = identities(keychain_path(), runner=runner)
        check_signing(identity_set, profiles, entitlements)
        if inner is not None:
            inner()
    assert_clean(keychain.captured_search_list, runner=runner)


def _execution_root(runner, repo):
    """`bazel info execution_root`: cquery's output paths are relative to this, not the
    workspace root, which may hold no `bazel-out` entry under a nondefault `symlink_prefix`."""
    output = _run(
        runner, ["bazel", "info", "execution_root"], cwd=repo, env=child_env(), timeout=60,
        error="reading the Bazel execution root failed",
    ).decode("utf-8", "replace").strip()
    if not output or not os.path.isabs(output):
        raise WalterCiError("bazel info execution_root returned an unexpected value")
    return output


def _resolve_ipa(runner, repo, target, flags):
    """`target`'s one output under the same `flags` it was built with -- never a
    `bazel-bin` convenience-symlink guess (cookbook section 7.3)."""
    output = _run(
        runner, ["bazel", "cquery", "--output=files", target] + list(flags), cwd=repo, env=child_env(), timeout=120,
        error="resolving the IPA output failed",
    ).decode("utf-8", "replace")
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    if len(lines) != 1:
        raise WalterCiError("bazel cquery did not resolve to exactly one output")
    root = _execution_root(runner, repo)
    path = lines[0] if os.path.isabs(lines[0]) else os.path.join(root, lines[0])
    _require_regular_file(path)
    return path


def _copy_regular(src, dest):
    _require_regular_file(src)
    descriptor = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with open(src, "rb") as source, os.fdopen(descriptor, "wb") as handle:
        shutil.copyfileobj(source, handle)


def cmd_validate(args, *, runner=default_runner):
    if os.environ.get("DOPPLER_TOKEN") is not None:
        raise WalterCiError("validate must run without a Doppler token")
    ident = identity()
    _preflight(runner)
    _check_bazel_version(runner, args.checkout)
    clone = verify_source(args.checkout, runner=runner)
    env = child_env()
    _run(
        runner, ["bazel", "build", "--config=ci"] + list(HOST_MACOS_FLAGS) + ["--", "//apps/walter/..."],
        cwd=clone, env=env, timeout=1800, error="the device build failed",
    )
    _run(
        runner,
        ["bazel", "build", "--config=ci", "--config=ios_sim"] + list(HOST_MACOS_FLAGS) + ["--", "//apps/walter/ios:Walter"],
        cwd=clone, env=env, timeout=1800, error="the simulator build failed",
    )
    _run(
        runner, ["python3", "-m", "unittest", "discover", "-s", "apps/walter/tools/tests", "-t", "."],
        cwd=clone, env=env, timeout=600, error="the tools' own unit tests failed",
    )
    _write_receipt(args.checkout, "validation", ident, True, {
        "preflight": True, "bazel_version_pinned": True, "device_build": True, "simulator_build": True, "tool_tests": True,
    })


def cmd_signing_preflight(args, *, runner=default_runner):
    ident = identity()
    clone = verify_source(args.checkout, runner=runner)
    secrets = fetch_doppler("signing")
    config = load_release_config(clone)
    _signing_checks(runner, secrets, config, clone)
    _write_receipt(args.checkout, "signing-preflight", ident, True, {"signing": True})


def cmd_package(args, *, runner=default_runner):
    ident = identity()
    clone = verify_source(args.checkout, runner=runner)
    config = load_release_config(clone)
    _, version = build_version(ident, config)
    secrets = fetch_doppler("package")

    with _ApiKey(secrets) as pre_key:
        client = _asc_client(pre_key, runner)
        app_id = client.app_id(config["bundle_ids"]["app"])
        if client.builds(app_id, config["marketing_version"], version):
            raise WalterCiError("a build already exists for " + version)

    ipa_holder = {}
    build_flags = (
        "--config=beta", "--config=ios_device", "--ios_multi_cpus=arm64",
        "--embed_label=" + version, "--host_macos_minimum_os=15.0",
    )

    def _build():
        _run(
            runner, ["bazel", "build", config["bazel_target"]] + list(build_flags),
            cwd=clone, env=child_env(), timeout=3600, error="the package build failed",
        )
        ipa_holder["path"] = _resolve_ipa(runner, clone, config["bazel_target"], build_flags)

    _signing_checks(runner, secrets, config, clone, inner=_build)

    report = inspect(ipa_holder["path"], config, version, runner=runner)
    dest_dir = artifact_dir(args.checkout, "package")
    dest = os.path.join(dest_dir, "Walter.ipa")
    _copy_regular(ipa_holder["path"], dest)
    size = os.stat(dest).st_size
    digest = sha256_file(dest)
    write_json_exclusive(os.path.join(dest_dir, "inspection-report.json"), report)
    _write_receipt(
        args.checkout, "package", ident, True, {"version": version, "size": size, "sha256": digest},
        name="package-receipt.json",
    )


def cmd_stage_ipa(args, *, runner=default_runner):
    """The one stage that runs on the host: no Doppler, no Apple."""
    host_env = dict(os.environ)
    outcome = _run(
        runner, ["buildkite-agent", "step", "get", "outcome", "--step", "walter-package"],
        env=host_env, timeout=30, error="reading the package step's outcome failed",
    ).decode("utf-8", "replace").strip()
    if outcome != "passed":
        raise WalterCiError("the package step did not pass")
    commit = os.environ.get("BUILDKITE_COMMIT") or ""
    build_id = os.environ.get("BUILDKITE_BUILD_ID") or ""
    if _COMMIT_RE.match(commit) is None or _ID_RE.match(build_id) is None:
        raise WalterCiError("a Buildkite identifier has an unexpected shape")
    scratch = tempfile.mkdtemp(prefix="walter-stage-")
    try:
        _run(
            runner,
            [
                "buildkite-agent", "artifact", "download", "apps/walter/.ci-artifacts/package/*", scratch,
                "--step", "walter-package", "--build", build_id,
            ],
            env=host_env, timeout=600, error="downloading the package artifacts failed",
        )
        package_dir = os.path.join(scratch, "apps", "walter", ".ci-artifacts", "package")
        ipa_src = os.path.join(package_dir, "Walter.ipa")
        receipt_src = os.path.join(package_dir, "package-receipt.json")
        _require_regular_file(ipa_src)
        _require_regular_file(receipt_src)
        digest = _verify_receipt(receipt_src, ipa_src, commit=commit)
        dest_dir = artifact_dir(args.checkout, "upload-input")
        _move_into(ipa_src, os.path.join(dest_dir, "Walter.ipa"))
        _move_into(receipt_src, os.path.join(dest_dir, "package-receipt.json"))
        print("staged IPA sha256:", digest)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def _upload_ipa(runner, mount, ipa_path, api_key, ident):
    """Write `upload-attempt.json` before invoking `altool`. Never retried."""
    attempt = {
        "schema": SCHEMA, "stage": "upload", "commit": ident["commit"], "build_id": ident["build_id"],
        "job_id": ident["job_id"], "build_number": ident["build_number"],
    }
    write_json_exclusive(os.path.join(artifact_dir(mount, "upload"), "upload-attempt.json"), attempt)
    _run(
        runner,
        ["xcrun", "altool", "--upload-app", "-f", ipa_path, "-t", "ios", "--apiKey", api_key.key_id, "--apiIssuer", api_key.issuer],
        env=_altool_env(api_key), timeout=1800, error="xcrun altool --upload-app failed",
    )


def cmd_upload(args, *, runner=default_runner):
    ident = identity()
    clone = verify_source(args.checkout, runner=runner)
    config = load_release_config(clone)
    _, version = build_version(ident, config)

    input_dir = os.path.join(args.checkout, "apps", "walter", ".ci-artifacts", "upload-input")
    ipa_path = os.path.join(input_dir, "Walter.ipa")
    receipt_path = os.path.join(input_dir, "package-receipt.json")
    _require_regular_file(ipa_path)
    _require_regular_file(receipt_path)
    digest = _verify_receipt(receipt_path, ipa_path, commit=ident["commit"])
    inspect(ipa_path, config, version, runner=runner)

    secrets = fetch_doppler("upload")
    with _ApiKey(secrets) as api_key:
        client = _asc_client(api_key, runner)
        app_id = client.app_id(config["bundle_ids"]["app"])
        if client.builds(app_id, config["marketing_version"], version):
            raise WalterCiError("a build already exists for " + version)
        _upload_ipa(runner, args.checkout, ipa_path, api_key, ident)
        client.wait_valid(app_id, config["marketing_version"], version)

    _write_receipt(args.checkout, "upload", ident, True, {"version": version, "sha256": digest}, name="upload-receipt.json")


_HANDLERS = {
    "validate": cmd_validate,
    "signing-preflight": cmd_signing_preflight,
    "package": cmd_package,
    "stage-ipa": cmd_stage_ipa,
    "upload": cmd_upload,
}


def _build_parser():
    parser = argparse.ArgumentParser(prog="walter_ci.py")
    sub = parser.add_subparsers(dest="stage", required=True)
    for name in _HANDLERS:
        stage_parser = sub.add_parser(name)
        stage_parser.add_argument("--checkout", default=os.getcwd())
    return parser


def main(argv=None):
    args = _build_parser().parse_args(argv)
    try:
        _HANDLERS[args.stage](args)
    except WalterCiError as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
